@page
@model IndexModel
@{
    ViewData["Title"] = "Geohash Tools and Map Utilities";
    ViewData["Description"] = "Use geospatial tools to browse geohash grids, encode polygons into geohashes, and compress geohash sets for efficient storage and transfer.";
}

<section class="py-4">
    <h1 class="display-6">Map tools and geohash utilities.</h1>
    <p></p>
    <p></p>
    <div class="tool-tile-grid">
        <a class="tool-tile-card" asp-page="/Tools/GeohashBrowser" aria-label="Open Geohash Browser tool">
            <div class="tool-tile-image-wrap">
                <img class="tool-tile-image" src="~/_content/Ramn.Labs.Frontend/images/tools/geohash-browser-preview.jpg" alt="Geohash Browser preview" onerror="this.style.display='none'; this.parentElement.classList.add('is-empty');" />
                <span class="tool-tile-image-placeholder">Add image: wwwroot/images/tools/geohash-browser-preview.jpg</span>
            </div>
            <div class="tool-tile-body">
                <h2 class="h4 mb-2">Geohash Browser</h2>
                <p class="mb-0 text-body-secondary">The ergonomic geohash browser you always wanted. Browse the visible geohash grid for your current map view, select individual cells, and copy geohash values instantly.</p>
            </div>
        </a>        
        <a class="tool-tile-card" asp-page="/Tools/PolyHasher" aria-label="Open PolyHasher tool">
            <div class="tool-tile-image-wrap">
                <img class="tool-tile-image" src="~/_content/Ramn.Labs.Frontend/images/tools/polyhasher-preview.jpg" alt="PolyHasher preview" onerror="this.style.display='none'; this.parentElement.classList.add('is-empty');" />
                <span class="tool-tile-image-placeholder">Add image: wwwroot/images/tools/polyhasher-preview.jpg</span>
            </div>
            <div class="tool-tile-body">
                <h2 class="h4 mb-2">PolyHasher</h2>
                <p class="mb-0 text-body-secondary">Draw or paste polygon geometry, encode it into geohashes with selectable precision and mode, and download the generated set.</p>
            </div>
        </a>
        <a class="tool-tile-card" asp-page="/Tools/GeoRaptor" aria-label="Open GeoRaptor compression tool">
            <div class="tool-tile-image-wrap">
                <img class="tool-tile-image" src="~/_content/Ramn.Labs.Frontend/images/tools/georaptor-preview.jpg" alt="GeoRaptor preview" onerror="this.style.display='none'; this.parentElement.classList.add('is-empty');" />
                <span class="tool-tile-image-placeholder">Add image: wwwroot/images/tools/georaptor-preview.jpg</span>
            </div>
            <div class="tool-tile-body">
                <h2 class="h4 mb-2">GeoRaptor Compression</h2>
                <p class="mb-0 text-body-secondary">Compress large geohash sets into fewer cells while preserving coverage, then inspect and download the compressed output.</p>
            </div>
        </a>
        <a class="tool-tile-card" asp-page="/Tools/LaserBeam" aria-label="Open Laser Beam Irradiance tool">
            <div class="tool-tile-image-wrap">
                <img class="tool-tile-image" src="~/_content/Ramn.Labs.Frontend/images/tools/laser-beam-preview.jpg" alt="Laser Beam tool preview" onerror="this.style.display='none'; this.parentElement.classList.add('is-empty');" />
                <span class="tool-tile-image-placeholder">Add image: wwwroot/images/tools/laser-beam-preview.jpg</span>
            </div>
            <div class="tool-tile-body">
                <h2 class="h4 mb-2">Laser Beam Irradiance</h2>
                <p class="mb-0 text-body-secondary">Estimate beam spread and irradiance falloff from source to cutoff range with draggable map points and live metrics.</p>
            </div>
        </a>

    </div>
</section>
