@page
@model Ramn.Labs.Frontend.Pages.Tools.GeoRaptorModel
@{
    ViewData["Title"] = "GeoRaptor Tool";
}

@section Styles {
    <partial name="_LeafletMapStylesPartial" />
    <link rel="stylesheet" href="~/css/tools/georaptor.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 m-0">GeoRaptor Compression Tool</h1>
    <div id="queue-live-status"
         class="status-chip"
         hx-get="/api/compression-jobs/queue-status/fragment"
         hx-trigger="load, every 2s"
         hx-swap="innerHTML">Loading queue status...</div>
</div>

<div x-data="georaptorTool()" class="tool-grid">
    <section class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5">Input</h2>
            <p class="text-body-secondary small">Provide geohashes as text or upload a text file (one geohash per line).</p>

            <div class="mb-3">
                <label class="form-label" for="geohashText">Paste geohashes</label>
                <textarea id="geohashText"
                          class="form-control"
                          rows="10"
                          placeholder="u4pruydqqvj&#10;u4pruydqqvm"
                          x-model="inputText"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label" for="geohashFile">Or upload text file</label>
                <input id="geohashFile" class="form-control" type="file" accept=".txt,text/plain" x-ref="inputFile" />
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label" for="minPrecision">Min precision</label>
                    <input id="minPrecision" type="number" class="form-control" min="1" max="12" x-model.number="minPrecision" />
                </div>
                <div class="col-6">
                    <label class="form-label" for="maxPrecision">Max precision</label>
                    <input id="maxPrecision" type="number" class="form-control" min="1" max="12" x-model.number="maxPrecision" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary" x-on:click="submitJob()" x-bind:disabled="isSubmitting || isSubmissionLocked()">Compress</button>
                <button type="button" class="btn btn-outline-secondary" x-on:click="clearAll()">Clear</button>
                <a class="btn"
                   x-bind:href="canDownload ? downloadUrl : null"
                   x-bind:class="{ 'btn-success': canDownload, 'btn-outline-secondary disabled': !canDownload }"
                   x-bind:aria-disabled="!canDownload">Download</a>
            </div>

            <hr />

            <div class="small">
                <div><strong>Status:</strong> <span x-text="status ?? 'Idle'"></span></div>
                <div><strong>Message:</strong> <span x-text="message"></span></div>
                <div x-show="estimatedWaitSeconds !== null"><strong>Estimated wait:</strong> <span x-text="estimatedWaitSeconds"></span> sec</div>
                <div x-show="compressedCount !== null"><strong>Compressed count:</strong> <span x-text="compressedCount"></span></div>
                <div x-show="backendDurationMilliseconds !== null"><strong>Backend duration:</strong> <span x-text="formatDuration(backendDurationMilliseconds)"></span></div>
                <div x-show="downloadSizeBytes !== null"><strong>Download size:</strong> <span x-text="formatBytes(downloadSizeBytes)"></span></div>
                <div x-show="geometryCount > 0"><strong>Rendered geometries:</strong> <span x-text="geometryCount"></span></div>
                <div class="text-danger mt-2" x-show="error" x-text="error"></div>
            </div>
        </div>
    </section>

    <section class="card shadow-sm overflow-hidden map-card">
        <div class="map-container" x-ref="map"></div>
    </section>
</div>
<section class="card shadow-sm mt-3">
    <div class="card-body">
        <em>This tool uses <a href="https://github.com/andrerav/Geohash.GeoRaptor">Geohash.GeoRaptor</a> for geohash compression on the backend. Prebuilt packages are available on <a href="https://www.nuget.org/packages/Geohash.GeoRaptor/">NuGet</a>, and you can get the source code on <a href="https://github.com/andrerav/Geohash.GeoRaptor">Github</a>.</em>
    </div>
</section>

@section Scripts {
    <partial name="_LeafletMapScriptsPartial" />
    <script src="~/js/tools/georaptor.js" asp-append-version="true"></script>
}
