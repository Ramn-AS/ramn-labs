@page
@model Ramn.Labs.Frontend.Pages.Tools.PolyHasherModel
@{
    ViewData["Title"] = "Polygon to Geohash Encoder (PolyHasher)";
    ViewData["Description"] = "Convert POLYGON and MULTIPOLYGON WKT into geohash sets with configurable precision and mode, preview results on map, and download output files.";
    ViewData["SocialImagePath"] = "/_content/Ramn.Labs.Frontend/images/tools/polyhasher-preview.jpg";
}

@section Styles {
    <partial name="_LeafletMapStylesPartial" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.css" />
    <link rel="stylesheet" href="~/_content/Ramn.Labs.Frontend/css/tools/polyhasher.css" asp-append-version="true" />
}

<div x-data="polyhasherTool()"
     class="polyhasher-grid"
     x-bind:class="{ 'map-maximized': mapMaximized }"
     x-bind:style="mapMaximized ? '--map-maximized-top:' + maximizedTopOffset + 'px;' : ''">
    <section class="card shadow-sm controls-panel">
        <div class="card-body">
            <h1 class="h4 mb-3">PolyHasher</h1>
            <p class="text-body-secondary small">Polyhasher generates optimized geohash sets from your polygons. Paste POLYGON or MULTIPOLYGON WKT, or draw a polygon directly on the map.</p>

            <div class="mb-3">
                <label class="form-label" for="wktInput">Geometry WKT</label>
                <textarea id="wktInput"
                          class="form-control font-monospace"
                          rows="10"
                          x-model="wktInput"
                          x-on:input.debounce.400ms="updateInputGeometryPreview(false)"
                          placeholder="MULTIPOLYGON (((40 40, 20 45, 45 30, 40 40)), ((20 35, 45 20, 30 5, 10 10, 10 30, 20 35), (30 20, 20 25, 20 15, 30 20)))"></textarea>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label" for="precision">Precision</label>
                    <input id="precision" type="number" class="form-control" min="1" max="12" x-model.number="precision" x-on:change="persistPreferences()" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="mode">Mode</label>
                    <select id="mode" class="form-select" x-model="mode" x-on:change="persistPreferences()">
                        <option value="intersects">Intersects</option>
                        <option value="contains">Contains</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edgeHandling">Edge handling</label>
                    <select id="edgeHandling" class="form-select" x-model="edgeHandling" x-on:change="persistPreferences()">
                        <option value="web-mercator">Web Mercator</option>
                        <option value="wgs84">WGS 84</option>
                        <option value="geodesic">Geodesic</option>
                    </select>
                </div>
            </div>

            <div class="form-check mb-3">
                <input id="zipBeforeDownload" class="form-check-input" type="checkbox" x-model="zipBeforeDownload" x-on:change="persistPreferences()" />
                <label class="form-check-label" for="zipBeforeDownload">Zip result before download (Recommended)</label>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-primary" x-on:click="submitJob()" x-bind:disabled="isSubmitting || isSubmissionLocked()">Encode</button>
                <a class="btn"
                   x-bind:href="canDownload ? downloadUrl : null"
                   x-bind:class="{ 'btn-success': canDownload, 'btn-outline-secondary disabled': !canDownload }"
                   x-bind:aria-disabled="!canDownload">Download</a>
                <button type="button" class="btn btn-outline-secondary" x-on:click="clearAll()">Clear Map</button>
            </div>

            <hr />

            <div class="small status-block">
                <div><strong>Status:</strong> <span x-text="status ?? 'Idle'"></span></div>
                <div><strong>Message:</strong> <span x-text="message"></span></div>
                <div x-show="estimatedWaitSeconds !== null"><strong>Estimated wait:</strong> <span x-text="estimatedWaitSeconds"></span> sec</div>
                <div x-show="geohashCount !== null"><strong>Geohash count:</strong> <span x-text="geohashCount"></span></div>
                <div x-show="zipRatio !== null"><strong>Zip ratio:</strong> <span x-text="formatRatio(zipRatio)"></span></div>
                <div x-show="backendDurationMilliseconds !== null"><strong>Backend duration:</strong> <span x-text="formatDuration(backendDurationMilliseconds)"></span></div>
                <div x-show="downloadSizeBytes !== null"><strong>Download size:</strong> <span x-text="formatBytes(downloadSizeBytes)"></span></div>
                <div x-show="previewTruncated"><strong>Preview:</strong> Showing first <span x-text="geohashes.length"></span> values on map.</div>
                <div class="text-danger mt-2" x-show="error" x-text="error"></div>
            </div>

            <hr class="my-3" />

            <div id="queue-live-status"
                 class="status-chip"
                 hx-get="/api/polyhasher-jobs/queue-status/fragment"
                 hx-trigger="load, every 2s"
                 hx-swap="innerHTML">Loading queue status...</div>
            <hr class="my-3" />
            <em>This tool uses <a href="https://github.com/andrerav/Geohash.Polyhasher">Geohash.Polyhasher</a> for computing geohashes from a polygon. Prebuilt packages are available on <a href="https://www.nuget.org/packages/Geohash.Polyhasher/">NuGet</a>, and you can get the source code on <a href="https://github.com/andrerav/Geohash.Polyhasher">Github</a>.</em>
        </div>
    </section>

    <section class="card shadow-sm overflow-hidden map-card">
        <div class="map-canvas-actions">
            <button type="button"
                    class="btn btn-sm btn-light map-maximize-button"
                    x-on:click="toggleMapMaximized()"
                    x-bind:title="mapMaximized ? 'Restore map' : 'Maximize map'"
                    x-bind:aria-label="mapMaximized ? 'Restore map' : 'Maximize map'">
                <svg x-show="!mapMaximized" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M1 1h6v1.5H3.56L7.22 6.16 6.16 7.22 2.5 3.56V7H1zm14 0v6h-1.5V3.56l-3.66 3.66-1.06-1.06 3.66-3.66H9V1zm0 14H9v-1.5h3.44l-3.66-3.66 1.06-1.06 3.66 3.66V9H15zM1 15V9h1.5v3.44l3.66-3.66 1.06 1.06-3.66 3.66H7V15z"></path>
                </svg>
                <svg x-show="mapMaximized" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M6.25 1H1v5.25h1.5V3.56L6.22 7.3l1.06-1.06L3.56 2.5h2.69zm3.5 0v1.5h2.69L8.72 6.22 9.78 7.3l3.72-3.74v2.69H15V1zM6.22 8.72 2.5 12.44V9.75H1V15h5.25v-1.5H3.56l3.72-3.72zm3.56 0L8.72 9.78l3.72 3.72H9.75V15H15V9.75h-1.5v2.69z"></path>
                </svg>
            </button>
        </div>
        <div class="map-container" x-ref="map"></div>
    </section>
</div>


@section Scripts {
    <partial name="_LeafletMapScriptsPartial" />
    <script src="https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.js"></script>
    <script src="~/_content/Ramn.Labs.Frontend/js/tools/polyhasher.js" asp-append-version="true"></script>
}
